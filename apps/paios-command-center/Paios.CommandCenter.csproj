<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provider config travels with the app so a published container has the
         same defaults a local run does. -->
    <None Update="config\providers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config\services.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
