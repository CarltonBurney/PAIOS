# PAIOS configuration — copy to .env and fill in.
# Never commit a filled-in copy. Secrets belong in Azure Key Vault.

# --- Environment -------------------------------------------------------------
PAIOS_ENV=dev

# --- Model provider ----------------------------------------------------------
# mock    : deterministic, no cloud dependency (default; used by the test suite)
# foundry : Azure AI Foundry
PAIOS_PROVIDER=mock

# --- Azure AI Foundry --------------------------------------------------------
# Required only when PAIOS_PROVIDER=foundry.
# Endpoint is shown on the Foundry project's Overview blade.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Entra ID ----------------------------------------------------------------
# Authentication uses DefaultAzureCredential: `az login` locally, managed
# identity in Azure. No client secret is read from this file.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Paths -------------------------------------------------------------------
# PAIOS_POLICY_PATH defaults to policies/sample-governance-policies.json
PAIOS_POLICY_PATH=
# When unset, audit events stay in memory only.
PAIOS_AUDIT_PATH=
