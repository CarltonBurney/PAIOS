# PAIOS configuration — copy to .env and fill in.
# Never commit a filled-in copy. Secrets belong in Azure Key Vault.

# --- Environment -------------------------------------------------------------
PAIOS_ENV=dev

# --- Model provider ----------------------------------------------------------
# mock    : deterministic, no cloud dependency (default; used by the test suite)
# foundry : Azure AI Foundry
PAIOS_PROVIDER=mock

# --- Azure AI Foundry --------------------------------------------------------
# Required only when PAIOS_PROVIDER=foundry.
# Endpoint is shown on the Foundry project's Overview blade.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Entra ID ----------------------------------------------------------------
# Authentication uses DefaultAzureCredential: `az login` locally, managed
# identity in Azure. No client secret is read from this file.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Paths -------------------------------------------------------------------
# All default to the documents under policies/. Override only to point at a
# different policy set, e.g. a tenant-specific one.
# defaults to policies/policy-rules.json
PAIOS_POLICY_PATH=
# defaults to policies/risk-model.json
PAIOS_RISK_MODEL_PATH=
# defaults to policies/tool-registry.json
PAIOS_TOOL_REGISTRY_PATH=
# defaults to policies/registry-policies.json
PAIOS_REGISTRY_POLICY_PATH=
# When unset, audit events stay in memory only.
PAIOS_AUDIT_PATH=

# --- Development stack (docker compose) --------------------------------------
# Required. `docker compose up` fails fast if these are unset rather than
# falling back to a default password.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Optional overrides.
POSTGRES_USER=paios
POSTGRES_DB=paios
N8N_DB_NAME=n8n
POSTGRES_PORT=5432
REDIS_PORT=6379
N8N_PORT=5678
# Pin once verified against the local Docker install.
N8N_VERSION=latest
TZ=UTC
