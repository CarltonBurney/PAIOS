{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paios.dev/schemas/request-record.schema.json",
  "title": "PAIOS Request Record",
  "description": "The composite state of a governed request: context, classification, decision, approval, and execution. Populated progressively as the request moves through the lifecycle state machine.",
  "type": "object",
  "required": ["request_id", "state", "context", "policy_bundle_version", "submitted_at"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "idempotency_key": {
      "type": "string",
      "description": "Adapter-supplied. Re-submission with the same key returns the existing request rather than creating a second one."
    },
    "supersedes": {
      "type": "string",
      "description": "Request this one replaces. Terminal states are never reopened; a follow-up is a new request."
    },
    "submitted_at": { "type": "string", "format": "date-time" },
    "policy_bundle_version": {
      "type": "string",
      "description": "Pinned at context resolution and held for the request's entire lifetime."
    },
    "state": {
      "type": "string",
      "enum": [
        "RECEIVED",
        "CONTEXT_RESOLVED",
        "CLASSIFIED",
        "SCORED",
        "DECIDED",
        "AWAITING_APPROVAL",
        "ESCALATED",
        "EXECUTING",
        "REVIEWING",
        "PUBLISHED",
        "DENIED",
        "FAILED"
      ]
    },

    "context": {
      "type": "object",
      "description": "Resolved server-side from the directory. Never taken from the request payload.",
      "required": ["principal", "channel"],
      "additionalProperties": false,
      "properties": {
        "principal": { "type": "string" },
        "principal_role": { "type": "string" },
        "group_memberships": { "type": "array", "items": { "type": "string" } },
        "business_area": { "type": "string" },
        "channel": {
          "type": "string",
          "enum": ["teams", "copilot_studio", "http_api", "power_automate"]
        }
      }
    },

    "classification": {
      "type": "object",
      "required": ["request_type", "method"],
      "additionalProperties": false,
      "properties": {
        "request_type": {
          "type": "string",
          "enum": ["project", "technical", "logical", "core", "governance_change", "unclassified"]
        },
        "sensitivity_signals": { "type": "array", "items": { "type": "string" } },
        "method": {
          "type": "string",
          "enum": ["deterministic", "model_assisted", "fallback"],
          "description": "'fallback' records that the classifier was unavailable and the request was treated as unclassified."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "matched_rule_ids": { "type": "array", "items": { "type": "string" } }
      }
    },

    "risk_level": {
      "type": "string",
      "enum": ["low", "standard", "sensitive", "compliance", "security"]
    },

    "decision": {
      "type": "object",
      "required": ["effect", "matched_rule_ids", "bundle_version"],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string" },
        "effect": {
          "type": "string",
          "enum": ["allow", "require_approval", "deny"]
        },
        "matched_rule_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Empty when no rule matched, which resolves to require_approval."
        },
        "bundle_version": { "type": "string" },
        "obligations": { "type": "object" },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    },

    "approval": {
      "type": "object",
      "required": ["approver", "outcome", "responded_at", "bundle_version"],
      "additionalProperties": false,
      "properties": {
        "decision_id": { "type": "string" },
        "approver": { "type": "string" },
        "approver_role": { "type": "string" },
        "outcome": {
          "type": "string",
          "enum": ["approved", "rejected", "timed_out", "invalidated"],
          "description": "'invalidated' records an approval discarded because the pinned bundle version changed while the request was pending."
        },
        "responded_at": { "type": "string", "format": "date-time" },
        "bundle_version": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "execution": {
      "type": "object",
      "required": ["agent_role", "started_at"],
      "additionalProperties": false,
      "properties": {
        "agent_role": { "type": "string" },
        "model_identifier": {
          "type": "string",
          "description": "The system that actually produced the output, not the role that was requested."
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "outcome": { "type": "string", "enum": ["succeeded", "failed"] },
        "error_class": { "type": "string" }
      }
    },

    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_outcome": {
          "type": "string",
          "enum": ["accepted", "rejected", "not_required"]
        },
        "reviewer": { "type": "string" },
        "location": {
          "type": "string",
          "description": "Written destination. Must equal the output_target carried in the decision obligations."
        }
      }
    }
  }
}
